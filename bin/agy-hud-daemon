    async function fetchQuotaData() {
        const dot = document.getElementById('dock-sync-dot');
        if (dot) {
            dot.style.background = '#38bdf8';
            dot.style.transform = 'scale(1.25)';
        }
        try {
            const res = await fetch('/exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Codeium-Csrf-Token': CSRF
                },
                body: '{}'
            });
            const data = await res.json();
            lastPayload = data.response || data;
            window.__agy_last_payload = lastPayload;
            renderUI(lastPayload);
            updateTick();
        } catch(e) {
            console.error('Antigravity Quota fetch error:', e);
        } finally {
            if (dot) {
                setTimeout(() => {
                    dot.style.background = '#10b981';
                    dot.style.transform = 'scale(1)';
                }, 400);
            }
        }
    }

    function renderUI(payload) {
        let gemini5hPct = '%100';
        let geminiWeeklyPct = '%100';
        let claudePct = '%100';
        let minRemainingFraction = 1.0;

        const groups = payload.groups || [];
        const popoverItems = [];

        groups.forEach(g => {
            const gName = g.displayName || 'Grup';
            const buckets = g.buckets || [];
            buckets.forEach(b => {
                const frac = (b.remainingFraction !== undefined) ? b.remainingFraction : 1.0;
                if (frac < minRemainingFraction) minRemainingFraction = frac;
                const pctNum = (frac * 100).toFixed(1);
                const bId = (b.bucketId || '').toLowerCase();
                const bName = b.displayName || bId;
                const windowStr = b.window || '';

                if (bId === 'gemini-5h' || (bId.includes('5h') && gName.includes('Gemini'))) {
                    gemini5hPct = '%' + pctNum;
                    if (b.resetTime) {
                        targetResetTime = new Date(b.resetTime).getTime();
                    }
                } else if (bId === 'gemini-weekly' || (bId.includes('weekly') && gName.includes('Gemini'))) {
                    geminiWeeklyPct = '%' + pctNum;
                } else if (bId === '3p-5h' || bId.includes('3p') || gName.toLowerCase().includes('claude')) {
                    claudePct = '%' + pctNum;
                }

                popoverItems.push({
                    group: gName,
                    name: bName,
                    pct: pctNum,
                    fraction: frac,
                    resetTime: b.resetTime
                });
            });
        });

        // Ana Kapsül Değerleri
        const dockVal5h = document.getElementById('dock-val-5h');
        const dockFill5h = document.getElementById('dock-fill-5h');
        const dockWeekly = document.getElementById('dock-val-weekly');
        const dockClaude = document.getElementById('dock-val-claude');

        if (dockVal5h) {
            dockVal5h.innerText = gemini5hPct;
            const num = parseFloat(gemini5hPct.replace('%',''));
            dockVal5h.style.color = num > 50 ? '#34d399' : (num > 20 ? '#fbbf24' : '#f87171');
        }
        if (dockFill5h) dockFill5h.style.width = gemini5hPct.replace('%','') + '%';
        if (dockWeekly) dockWeekly.innerText = geminiWeeklyPct;
        if (dockClaude) dockClaude.innerText = claudePct;

        // Kritik Seviye Vurgusu
        const bar = document.getElementById('chat-dock-quota-bar');
        if (bar) {
            if (minRemainingFraction <= 0.15) {
                bar.style.borderColor = 'rgba(248, 113, 113, 0.4)';
                bar.style.boxShadow = '0 0 12px rgba(239, 68, 68, 0.25)';
            } else {
                bar.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.3)';
            }
        }

        // Popover İçeriğini Doldur
        const popover = document.getElementById('dock-quota-popover');
        if (popover && popoverItems.length > 0) {
            let html = `
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:6px;">
                    <span style="font-weight:700; color:#f4f4f5; display:inline-flex; align-items:center; gap:5px;">⚡ Model Kotaları & Kalan Limitler</span>
                    <span style="color:#71717a; font-size:10px;">${popoverItems.length} Havuz</span>
                </div>
            `;
            popoverItems.forEach(item => {
                const color = item.fraction > 0.5 ? '#34d399' : (item.fraction > 0.2 ? '#fbbf24' : '#f87171');
                const remMs = item.resetTime ? (new Date(item.resetTime).getTime() - Date.now()) : 0;
                const remStr = formatTimeRemaining(remMs);

                html += `
                    <div style="margin-bottom:6px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
                            <span style="font-weight:500; color:#a1a1aa;">${item.group} - ${item.name}</span>
                            <span style="font-weight:700; font-family:monospace; color:${color};">%${item.pct}</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <div style="flex:1; height:4px; background:rgba(255,255,255,0.08); border-radius:99px; overflow:hidden;">
                                <div style="width:${item.pct}%; height:100%; background:${color}; border-radius:99px;"></div>
                            </div>
                            <span style="font-size:10px; color:#71717a; font-family:monospace; flex-shrink:0;">⏱️ ${remStr}</span>
                        </div>
                    </div>
                `;
            });
            html += `<div style="font-size:9.5px; color:#52525b; text-align:center; margin-top:6px; border-top:1px solid rgba(255,255,255,0.05); padding-top:4px;">Yenilemek için 'Canlı' simgesine tıklayın</div>`;
            popover.innerHTML = html;
        }
    }

    function updateTick() {
        if (!targetResetTime) return;
        const diff = targetResetTime - Date.now();
        const dockTime = document.getElementById('dock-val-time');

        let formatted = '00:00:00';
        let color = '#34d399';

        if (diff > 0) {
            const h = Math.floor(diff / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            formatted = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
            color = '#fbbf24';
        }

        if (dockTime) {
            dockTime.innerText = formatted;
            dockTime.style.color = color;
        }
    }

    ensureBar();
    fetchQuotaData();

    if (!window.__agy_quota_v5_setup) {
        window.__agy_quota_v5_setup = true;
        setInterval(updateTick, 1000);
        setInterval(fetchQuotaData, 10000);
        window.addEventListener('focus', fetchQuotaData);

        const observer = new MutationObserver(() => {
            ensureBar();
        });
        observer.observe(document.body, { childList: true, subtree: true });
    }
})();
"""

async def cdp_eval(ws, expression):
    req_id = int(time.time() * 1000) % 1000000
    await ws.send(json.dumps({
        'id': req_id,
        'method': 'Runtime.evaluate',
        'params': {'expression': expression, 'returnByValue': True}
    }))
    start = time.time()
    while time.time() - start < 2.5:
        raw = await asyncio.wait_for(ws.recv(), timeout=2.0)
        msg = json.loads(raw)
        if msg.get('id') == req_id:
            return msg.get('result', {}).get('result', {}).get('value')
    return None

class QuotaAlertManager:
    def __init__(self):
        self.alerted_levels = {}

    def check_and_alert(self, payload):
        if not payload or not isinstance(payload, dict):
            return
        groups = payload.get('groups', [])
        for g in groups:
            for b in g.get('buckets', []):
                b_id = b.get('bucketId', 'default')
                b_name = b.get('displayName', b_id)
                frac = b.get('remainingFraction', 1.0)
                pct = frac * 100.0

                if b_id not in self.alerted_levels:
                    self.alerted_levels[b_id] = set()

                if pct <= 5.0:
                    if '5' not in self.alerted_levels[b_id]:
                        send_desktop_notification(
                            "🚨 Antigravity Kota Uyarısı (%5)",
                            f"{b_name} kotanız %{pct:.1f} seviyesine indi! Limit bitmek üzere."
                        )
                        self.alerted_levels[b_id].add('5')
                        self.alerted_levels[b_id].add('15')
                elif pct <= 15.0:
                    if '15' not in self.alerted_levels[b_id]:
                        send_desktop_notification(
                            "⚠️ Antigravity Kota Uyarısı (%15)",
                            f"{b_name} kotanız %{pct:.1f} seviyesine geriledi."
                        )
                        self.alerted_levels[b_id].add('15')
                elif pct > 75.0 and len(self.alerted_levels[b_id]) > 0:
                    # Kota yenilendiğinde bildirim durumunu sıfırla
                    self.alerted_levels[b_id].clear()

async def run_daemon():
    print("Starting Antigravity Responsive Quota HUD Daemon v5...", flush=True)
    alert_mgr = QuotaAlertManager()
    sleep_interval = 2
    max_backoff = 25
    last_alert_check = 0

    while True:
        try:
            port = get_cdp_port()
            csrf = get_csrf()
            if port and csrf:
                sleep_interval = 2  # Antigravity aktif, hızlı döngü
                code_to_inject = HUD_JS_TEMPLATE.replace('__CSRF_TOKEN__', json.dumps(csrf))
                req = urllib.request.urlopen(f'http://127.0.0.1:{port}/json', timeout=1.5)
                pages = json.loads(req.read().decode('utf-8'))
                for p in pages:
                    if p.get('type') != 'page':
                        continue
                    ws_url = p.get('webSocketDebuggerUrl')
                    if ws_url:
                        try:
                            async with websockets.connect(ws_url, open_timeout=1.5, close_timeout=1.0) as ws:
                                check_expr = '!!document.getElementById("chat-dock-quota-bar") && document.getElementById("chat-dock-quota-bar").getAttribute("data-v") === "5" && !document.getElementById("antigravity-quota-hud") && !document.getElementById("test-quota-banner")'
                                is_clean = await cdp_eval(ws, check_expr)
                                if not is_clean:
                                    await cdp_eval(ws, code_to_inject)
                                    print(f"Updated Quota Bar v5 on: {p.get('title')}", flush=True)

                                # Masaüstü bildirim kontrolü (her 30 saniyede bir)
                                if time.time() - last_alert_check > 30:
                                    payload = await cdp_eval(ws, 'window.__agy_last_payload || null')
                                    if payload:
                                        alert_mgr.check_and_alert(payload)
                                        last_alert_check = time.time()
                        except Exception:
                            pass
            else:
                # Antigravity açık değilse CPU ve pil tasarrufu için bekleme süresini katla
                sleep_interval = min(sleep_interval + 5, max_backoff)
        except Exception:
            sleep_interval = min(sleep_interval + 5, max_backoff)

        await asyncio.sleep(sleep_interval)

if __name__ == '__main__':
    asyncio.run(run_daemon())
